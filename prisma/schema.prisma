generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum SystemRole {
  ADMINISTRATOR
  NATIONAL_COORDINATOR
  STATE_COORDINATOR
  COURSE_COORDINATOR
  CPR_INSTRUCTOR
  CPR_CHAMPION
  PARTICIPANT
}

enum RoleAssignmentStatus {
  PENDING
  ACTIVE
  SUSPENDED
  REJECTED
  EXPIRED
}

enum RoleScopeType {
  GLOBAL
  NATIONAL
  STATE
  COURSE
  SELF
}

enum CourseStatus {
  DRAFT
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

enum Gender {
  MALE
  FEMALE
  OTHER
  PREFER_NOT_TO_SAY
}

enum ParticipantCategory {
  SCHOOL_STUDENT
  COLLEGE_STUDENT
  TEACHER
  HEALTHCARE_WORKER
  POLICE_PERSONNEL
  ARMED_FORCES
  RWA_MEMBER
  NGO_VOLUNTEER
  CORPORATE_EMPLOYEE
  COMMUNITY_MEMBER
  IAP_MEMBER
  OTHER
}

enum RegistrationSource {
  PUBLIC_FORM
  COORDINATOR_ENTRY
  BULK_UPLOAD
  ADMIN_ENTRY
}

enum RegistrationStatus {
  REGISTERED
  CANCELLED
  DUPLICATE
  REJECTED
}

enum AttendanceStatus {
  NOT_MARKED
  PRESENT
  ABSENT
}

enum CompletionStatus {
  NOT_ASSESSED
  COMPLETED
  NOT_COMPLETED
}

enum CertificateStatus {
  NOT_ELIGIBLE
  ELIGIBLE
  GENERATED
  DOWNLOADED
  REVOKED
}

enum UploadBatchStatus {
  PENDING
  PROCESSING
  COMPLETED
  COMPLETED_WITH_ERRORS
  FAILED
}

enum CourseTeamRole {
  COURSE_COORDINATOR
  CPR_INSTRUCTOR
  CPR_CHAMPION
}

enum CourseTeamStatus {
  INVITED
  ACCEPTED
  DECLINED
  REMOVED
}

model User {
  id               String    @id @default(cuid())
  fullName         String
  email            String?   @unique
  mobileNumber     String?   @unique
  passwordHash     String?
  isActive         Boolean   @default(true)
  emailVerifiedAt  DateTime?
  mobileVerifiedAt DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  roleAssignments       UserRole[]         @relation("UserRoleOwner")
  rolesApproved         UserRole[]         @relation("UserRoleApprover")
  courseTeamMemberships CourseTeamMember[] @relation("CourseTeamUser")
  courseTeamInvitations CourseTeamMember[] @relation("CourseTeamInviter")

  @@index([fullName])
  @@index([isActive])
}

model UserRole {
  id               String               @id @default(cuid())
  userId           String
  role             SystemRole
  scopeType        RoleScopeType
  stateCode        String?
  courseId         String?
  status           RoleAssignmentStatus @default(PENDING)
  approvedByUserId String?
  approvedAt       DateTime?
  validFrom        DateTime?
  validUntil       DateTime?
  notes            String?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  user       User  @relation("UserRoleOwner", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User? @relation("UserRoleApprover", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([role, status])
  @@index([stateCode, role])
  @@index([courseId, role])
}

model Course {
  id          String       @id @default(cuid())
  courseCode  String       @unique
  title       String
  description String?
  status      CourseStatus @default(DRAFT)

  courseDate DateTime
  startTime  String?
  endTime    String?

  venueName    String
  addressLine1 String?
  addressLine2 String?
  city         String
  district     String
  state        String
  stateCode    String
  postalCode   String?
  metadata     Json?

  expectedParticipants Int?
  maximumParticipants  Int?

  isPublicRegistrationOpen Boolean @default(false)

  approvedByUserId String?
  approvedAt       DateTime?
  rejectionReason  String?

  createdAt          DateTime                 @default(now())
  updatedAt          DateTime                 @updatedAt
  participants       CourseParticipant[]
  participantUploads ParticipantUploadBatch[]
  teamMembers        CourseTeamMember[]

  @@index([stateCode, courseDate])
  @@index([status])
  @@index([courseDate])
}

model Participant {
  id String @id @default(cuid())

  fullName       String
  normalizedName String

  mobileNumber     String?
  normalizedMobile String?

  email           String?
  normalizedEmail String?

  age                 Int?
  gender              Gender?
  participantCategory ParticipantCategory @default(COMMUNITY_MEMBER)

  organisationName String?
  designation      String?

  city       String?
  district   String?
  state      String?
  postalCode String?

  emergencyContactName   String?
  emergencyContactMobile String?

  consentToParticipate    Boolean @default(false)
  consentForPhoto         Boolean @default(false)
  consentForCommunication Boolean @default(false)

  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  courseRegistrations CourseParticipant[]

  @@index([normalizedName, normalizedMobile])
  @@index([normalizedName, normalizedEmail])
  @@index([state, district])
  @@index([participantCategory])
}

model CourseParticipant {
  id            String @id @default(cuid())
  courseId      String
  participantId String

  registrationSource RegistrationSource
  registrationStatus RegistrationStatus @default(REGISTERED)

  registeredAt DateTime @default(now())

  attendanceStatus   AttendanceStatus @default(NOT_MARKED)
  attendedAt         DateTime?
  attendanceMarkedAt DateTime?

  completionStatus   CompletionStatus @default(NOT_ASSESSED)
  completionMarkedAt DateTime?

  certificateStatus      CertificateStatus @default(NOT_ELIGIBLE)
  certificateNumber      String?           @unique
  certificateGeneratedAt DateTime?
  certificateUrl         String?
  sourceRowNumber        Int?
  bulkUploadBatchId      String?
  remarks                String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  participant     Participant             @relation(fields: [participantId], references: [id], onDelete: Cascade)
  bulkUploadBatch ParticipantUploadBatch? @relation(fields: [bulkUploadBatchId], references: [id], onDelete: SetNull)

  @@unique([courseId, participantId])
  @@index([courseId, attendanceStatus])
  @@index([courseId, completionStatus])
  @@index([courseId, certificateStatus])
  @@index([participantId])
}

model ParticipantUploadBatch {
  id       String @id @default(cuid())
  courseId String

  originalFileName String
  storedFileUrl    String?
  googleDriveFileId String?

  uploadedByCoordinatorId String
  uploadSequence          Int

  observerName        String
  observerMobile      String
  observerDesignation String
  observerAffiliation String
  observerEmail       String

  totalRows     Int @default(0)
  validRows     Int @default(0)
  importedRows  Int @default(0)
  duplicateRows Int @default(0)
  errorRows     Int @default(0)

  status          UploadBatchStatus @default(PENDING)
  errorReportUrl  String?
  processingNotes String?

  createdAt   DateTime  @default(now())
  processedAt DateTime?
  updatedAt   DateTime  @updatedAt

  course        Course              @relation(fields: [courseId], references: [id], onDelete: Cascade)
  registrations CourseParticipant[]

  @@unique([courseId, uploadSequence])
  @@index([courseId])
  @@index([uploadedByCoordinatorId])
  @@index([status])
}

model CourseTeamMember {
  id       String @id @default(cuid())
  courseId String
  userId   String

  teamRole CourseTeamRole
  status   CourseTeamStatus @default(INVITED)

  invitedById String?
  invitedAt   DateTime  @default(now())
  respondedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  user User @relation("CourseTeamUser", fields: [userId], references: [id], onDelete: Cascade)

  invitedBy User? @relation("CourseTeamInviter", fields: [invitedById], references: [id], onDelete: SetNull)

  @@unique([courseId, userId, teamRole])
  @@index([courseId, teamRole, status])
  @@index([userId, status])
}

model SanjeevaniCertificate {
  id                 String   @id @default(cuid())
  certificateId      String   @unique
  sequenceNumber     Int
  stateCode          String
  participantName    String
  normalizedName     String
  date               String
  venue              String
  city               String
  state              String
  mobileNumber       String?
  email              String?
  uploadBatchId      String?
  status             String   @default("GENERATED")
  certificateFileUrl String?
  metadata           Json?
  generatedAt        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  batch              SanjeevaniUploadBatch? @relation(fields: [uploadBatchId], references: [id], onDelete: SetNull)

  @@index([stateCode, sequenceNumber])
  @@index([certificateId])
  @@index([stateCode])
  @@index([normalizedName, stateCode])
  @@index([mobileNumber])
  @@index([email])
}

model SanjeevaniUploadBatch {
  id               String   @id @default(cuid())
  originalFileName String
  totalRows        Int      @default(0)
  validRows        Int      @default(0)
  importedRows     Int      @default(0)
  duplicateRows    Int      @default(0)
  errorRows        Int      @default(0)
  status           String   @default("COMPLETED")
  processingNotes  String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  certificates     SanjeevaniCertificate[]
}

enum CertificateCategoryType {
  PARTICIPANT
  CPR_CHAMPION
  COURSE_COORDINATOR
  CPR_FACILITY
}

model AdminCertificateRecord {
  id                String                  @id @default(cuid())
  certificateId     String                  @unique
  category          CertificateCategoryType

  name              String
  normalizedName    String

  certificateDate   String

  venueName         String?
  venueCode         String?

  city              String?
  state             String
  stateCode         String

  mobileNumber      String?
  email             String?

  courseCoordinator String?

  status            String                  @default("VALID")
  source            String                  @default("MANUAL_ADMIN")
  notes             String?

  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  @@index([category, stateCode])
  @@index([normalizedName, stateCode])
  @@index([mobileNumber])
  @@index([email])
}

model MBBSProfessionalSurveyResponse {
  id                            String   @id @default(cuid())
  createdAt                     DateTime @default(now())
  updatedAt                     DateTime @updatedAt
  surveyVersion                 String   @default("v1")

  // Source / Entry Route
  source                        String?

  // Professional Profile
  roles                         Json
  specialty                     String?
  teachingExperience            String?
  institutionName               String?
  city                          String?
  state                         String?
  stateCode                     String?

  // Survey Responses
  surveyResponses               Json

  // Contributor / Follow-up Fields
  interestedInContributing      Boolean  @default(false)
  contributionInterests         Json?
  willingToShareReadinessSurvey Boolean  @default(false)

  // Optional Contact Information
  respondentName                String?
  email                         String?
  mobileWhatsapp                String?

  // Consent
  consentForFollowup            Boolean  @default(false)

  // Future Referral Support
  referralCode                  String?

  // Duplicate / Abuse Protection Readiness
  submissionFingerprint         String?

  @@index([createdAt])
  @@index([source])
  @@index([state])
  @@index([interestedInContributing])
  @@index([willingToShareReadinessSurvey])
}

model MBBSStudentVoiceSurveyResponse {
  id                       String   @id @default(cuid())
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt

  surveyVersion            String   @default("v1")
  source                   String?

  trainingStage            String
  collegeType              String?
  state                    String?
  stateCode                String?

  surveyResponses          Json

  interestedInContributing Boolean  @default(false)
  contributionInterests    Json?

  consentForFollowup       Boolean  @default(false)
  respondentName           String?
  email                    String?
  mobileWhatsapp           String?

  referralCode             String?
  submissionFingerprint    String?

  @@index([createdAt])
  @@index([source])
  @@index([trainingStage])
  @@index([state])
  @@index([interestedInContributing])
}

// ============================================================================
// NEET-UG COUNSELLING DECISION-SUPPORT DOMAIN (ADDITIVE FOUNDATION)
// ============================================================================

enum CounsellingManagementType {
  GOVERNMENT
  PRIVATE
  DEEMED
  CENTRAL
  INI
  OTHER
}

enum CounsellingAuthorityType {
  MCC
  STATE
  UNIVERSITY
  OTHER
}

enum CounsellingRoundType {
  ROUND_1
  ROUND_2
  ROUND_3
  STRAY
  OTHER
}

enum CounsellingRoundStatus {
  UPCOMING
  ACTIVE
  COMPLETED
}

enum CounsellingDataType {
  CAPACITY
  SEAT_MATRIX
  ALLOTMENT
  VACANCY
  CUTOFF
  NEW_SEATS
  OTHER
}

enum CounsellingImportStatus {
  IMPORTED
  VALIDATED
  ACTIVE
  SUPERSEDED
  FAILED
}

enum CounsellingSourceStatus {
  OFFICIAL
  REVISED
  SUPERSEDED
}

enum CounsellingMatchConfidence {
  EXACT
  VERIFIED
  PROBABLE
  UNRESOLVED
}

enum CounsellingSeatCategory {
  OPEN
  OBC
  EWS
  SC
  ST
  OTHER
}

enum CounsellingVacancyType {
  CLEAR
  VIRTUAL
  NEWLY_ADDED
  CONVERTED
  REVERTED
  OTHER
}

enum CounsellingOpportunityBand {
  STRONG
  REALISTIC
  STRETCH
  LOW_EVIDENCE
}

model College {
  id                  String                    @id @default(cuid())
  nmcCollegeCode      String?                   @unique
  mccInstituteCode    String?
  slug                String                    @unique
  collegeName         String
  shortName           String?
  state               String
  city                String?
  managementType      CounsellingManagementType
  instituteType       String?
  isINI               Boolean                   @default(false)
  isDeemed            Boolean                   @default(false)
  isCentralUniversity Boolean                   @default(false)
  isESIC              Boolean                   @default(false)
  genderRestriction   String?
  establishmentYear   Int?
  isActive            Boolean                   @default(true)
  createdAt           DateTime                  @default(now())
  updatedAt           DateTime                  @updatedAt

  aliases            CollegeAlias[]
  capacities         CollegeAnnualCapacity[]
  seatMatrixRecords  SeatMatrixRecord[]
  allotmentRecords   AllotmentRecord[]
  vacancyRecords     VacancyRecord[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@index([state])
  @@index([managementType])
  @@index([isActive])
  @@index([mccInstituteCode])
}

model CollegeAlias {
  id                   String                     @id @default(cuid())
  collegeId            String
  sourceAuthority      CounsellingAuthorityType
  sourceName           String
  sourceInstituteCode  String?
  normalizedName       String
  matchConfidence      CounsellingMatchConfidence
  createdAt            DateTime                   @default(now())
  updatedAt            DateTime                   @updatedAt

  college College @relation(fields: [collegeId], references: [id], onDelete: Cascade)

  @@index([collegeId])
  @@index([sourceAuthority, sourceInstituteCode])
  @@index([sourceAuthority, normalizedName])
}

model CollegeAnnualCapacity {
  id                 String                  @id @default(cuid())
  collegeId          String
  academicYear       Int
  approvedSeats      Int
  renewedSeats       Int?
  increasedSeats     Int?
  isNewEstablishment Boolean                 @default(false)
  sourceImportId     String?
  sourceDate         DateTime?
  status             CounsellingSourceStatus @default(OFFICIAL)
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  college      College                @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  sourceImport CounsellingDataImport? @relation(fields: [sourceImportId], references: [id], onDelete: SetNull)

  @@index([collegeId, academicYear])
  @@index([sourceImportId])
  @@index([status])
}

model CounsellingAuthority {
  id            String                   @id @default(cuid())
  name          String                   @unique
  shortName     String?
  authorityType CounsellingAuthorityType
  state         String?
  website       String?
  isActive      Boolean                  @default(true)
  createdAt     DateTime                 @default(now())
  updatedAt     DateTime                 @updatedAt

  rounds             CounsellingRound[]
  imports            CounsellingDataImport[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@index([authorityType])
  @@index([state])
  @@index([isActive])
}

model CounsellingRound {
  id                  String                 @id @default(cuid())
  academicYear        Int
  authorityId         String
  roundType           CounsellingRoundType
  status              CounsellingRoundStatus @default(UPCOMING)
  seatMatrixPublished Boolean                @default(false)
  allotmentPublished  Boolean                @default(false)
  vacancyPublished    Boolean                @default(false)
  publishedAt         DateTime?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  authority CounsellingAuthority @relation(fields: [authorityId], references: [id], onDelete: Cascade)

  imports            CounsellingDataImport[]
  seatMatrixRecords  SeatMatrixRecord[]
  allotmentRecords   AllotmentRecord[]
  vacancyRecords     VacancyRecord[]
  analyticsSnapshots AnalyticsSnapshot[]

  @@unique([authorityId, academicYear, roundType])
  @@index([academicYear, status])
  @@index([authorityId])
}

model CounsellingDataImport {
  id             String                  @id @default(cuid())
  academicYear   Int
  authorityId    String
  roundId        String?
  dataType       CounsellingDataType
  sourceFileName String
  sourceDate     DateTime?
  isOfficial     Boolean                 @default(true)
  revisionNumber Int                     @default(1)
  status         CounsellingImportStatus @default(IMPORTED)
  rowCount       Int?
  errorCount     Int?
  notes          String?
  importedAt     DateTime                @default(now())
  activatedAt    DateTime?
  supersededAt   DateTime?

  authority CounsellingAuthority @relation(fields: [authorityId], references: [id], onDelete: Cascade)
  round     CounsellingRound?     @relation(fields: [roundId], references: [id], onDelete: SetNull)

  capacities        CollegeAnnualCapacity[]
  seatMatrixRecords SeatMatrixRecord[]
  allotmentRecords  AllotmentRecord[]
  vacancyRecords    VacancyRecord[]

  @@index([authorityId, academicYear, dataType])
  @@index([roundId])
  @@index([status])
}

model SeatMatrixRecord {
  id                  String                  @id @default(cuid())
  roundId             String
  collegeId           String
  sourceImportId      String
  course              String                  @default("MBBS")
  quota               String
  seatCategory        CounsellingSeatCategory
  isPwD               Boolean                 @default(false)
  gender              String?
  specialPathway      String?
  seatCount           Int
  sourceInstituteName String?
  sourceInstituteCode String?
  sourceCategoryLabel String?
  isOfficial          Boolean                 @default(true)
  revisionNumber      Int                     @default(1)
  createdAt           DateTime                @default(now())

  round        CounsellingRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  college      College               @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  sourceImport CounsellingDataImport @relation(fields: [sourceImportId], references: [id], onDelete: Cascade)

  @@index([collegeId, roundId])
  @@index([roundId, quota, seatCategory, isPwD])
  @@index([sourceImportId])
}

model AllotmentRecord {
  id                          String                  @id @default(cuid())
  roundId                     String
  collegeId                   String
  sourceImportId              String
  candidateRank               Int
  course                      String                  @default("MBBS")
  quota                       String
  allottedCategory            CounsellingSeatCategory
  allottedPwD                 Boolean                 @default(false)
  candidateCategory           CounsellingSeatCategory
  candidatePwD                Boolean                 @default(false)
  specialPathway              String?
  allotmentStatus             String?
  sourceSerialNumber          Int?
  sourceInstituteName         String?
  sourceQuotaLabel            String?
  sourceAllottedCategoryLabel String?
  sourceCandidateCategoryLabel String?
  rawSourceText               String?
  createdAt                   DateTime                @default(now())

  round        CounsellingRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  college      College               @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  sourceImport CounsellingDataImport @relation(fields: [sourceImportId], references: [id], onDelete: Cascade)

  @@index([roundId, collegeId])
  @@index([roundId, quota, allottedCategory, allottedPwD])
  @@index([candidateRank])
  @@index([sourceImportId])
}

model VacancyRecord {
  id                  String                  @id @default(cuid())
  roundId             String
  collegeId           String
  sourceImportId      String
  quota               String
  seatCategory        CounsellingSeatCategory
  isPwD               Boolean                 @default(false)
  specialPathway      String?
  gender              String?
  vacancyType         CounsellingVacancyType
  seatCount           Int
  sourceCategoryLabel String?
  isOfficial          Boolean                 @default(true)
  revisionNumber      Int                     @default(1)
  createdAt           DateTime                @default(now())

  round        CounsellingRound      @relation(fields: [roundId], references: [id], onDelete: Cascade)
  college      College               @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  sourceImport CounsellingDataImport @relation(fields: [sourceImportId], references: [id], onDelete: Cascade)

  @@index([collegeId, roundId])
  @@index([roundId, quota, seatCategory, isPwD, vacancyType])
  @@index([sourceImportId])
}

model AnalyticsSnapshot {
  id                 String                  @id @default(cuid())
  collegeId          String
  authorityId        String
  roundId            String
  quota              String
  seatCategory       CounsellingSeatCategory
  isPwD              Boolean                 @default(false)
  specialPathway     String?
  seatsOffered       Int
  seatsAllotted      Int
  matrixGap          Int
  fillRate           Float
  sampleSize         Int
  bestAIR            Int?
  q1AIR              Float?
  medianAIR          Float?
  q3AIR              Float?
  highestAIR         Int?
  calculationVersion String                  @default("v1")
  calculatedAt       DateTime                @default(now())

  college   College              @relation(fields: [collegeId], references: [id], onDelete: Cascade)
  authority CounsellingAuthority @relation(fields: [authorityId], references: [id], onDelete: Cascade)
  round     CounsellingRound     @relation(fields: [roundId], references: [id], onDelete: Cascade)

  @@index([collegeId, authorityId, roundId])
  @@index([roundId, quota, seatCategory, isPwD])
  @@index([highestAIR])
  @@index([authorityId])
}

